{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "pulse-energy-web-new",
            "runtimeExecutable": "python3",
            "runtimeArgs": [
                "-m",
                "http.server",
                "4173",
                "--directory",
                "pulse-energy-web-new"
            ],
            "port": 4173
        },
        {
            "name": "central-console",
            "runtimeExecutable": "npx",
            "runtimeArgs": [
                "env-cmd",
                "-f",
                ".dev.env",
                "vite",
                "--port",
                "3001",
                "--strictPort"
            ],
            "cwd": "central-console",
            "port": 3001
        },
        {
            "name": "central-console-preprod",
            "runtimeExecutable": "env",
            "runtimeArgs": [
                "REACT_APP_API_ENDPOINT=https://preprod-central-api.pulseenergy.io/api/console",
                "REACT_APP_V4_API_ENDPOINT=https://preprod-central-api.pulseenergy.io/api/console/v4",
                "npx",
                "env-cmd",
                "--no-override",
                "-f",
                ".dev.env",
                "vite",
                "--port",
                "3000",
                "--strictPort"
            ],
            "cwd": "central-console",
            "port": 3000
        },
        {
            "name": "pulse-dataverse-eval",
            "runtimeExecutable": "sh",
            "runtimeArgs": [
                "-c",
                "cd \"/private/tmp/claude-501/-Users-devangmstryls-desk-projects-pulse/74555710-9a52-4282-a86c-88ccd44e5357/scratchpad/wt-dataverse-eval\" && TS_NODE_TRANSPILE_ONLY=true npx nodemon"
            ],
            "port": 9500
        },
        {
            "name": "pulse-dataverse",
            "runtimeExecutable": "sh",
            "runtimeArgs": [
                "-c",
                "TS_NODE_TRANSPILE_ONLY=true npx nodemon"
            ],
            "cwd": "pulse-dataverse",
            "port": 9000
        }
    ]
